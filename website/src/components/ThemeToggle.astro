---
// Theme switch. The site ships dark (site.css keeps dark as the unattributed
// base), so this opts into light and persists the choice; the inline script in
// <head> re-applies it before the first paint to avoid a flash.
// The icon shows the theme you'd switch TO.
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const sync = (): void => {
    const light = root.dataset.theme === 'light';
    btn?.setAttribute('aria-pressed', String(light));
    btn?.setAttribute('title', light ? 'Switch to dark' : 'Switch to light');
    // keep the browser UI (address bar, PWA chrome) on the chosen theme
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', light ? '#fcfcfc' : '#09090b');
  };

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('crd-ui-theme', next);
    } catch {
      // private mode / storage disabled — the toggle still works for this visit
    }
    sync();
  });

  sync();
</script>
